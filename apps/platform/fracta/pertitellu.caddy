# Inseme #59 / Operium #37 — PREPARED, NOT DEPLOYED.
# Copy to the live Fracta2 Caddy import directory only after verifying a stable
# public ingress (Operium #77), an existing release at /srv/www/pertitellu/current,
# and the exact authorized Cloudflare DNS record lepp.baronsmariani.org.
# Public vhost intentionally serves ONLY en-preparation.html.
# The SPA build stays private until backend tenancy and COP constraints pass.
https://lepp.baronsmariani.org {
	root * /srv/www/pertitellu/current
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	@health path /health
	handle @health {
		header Content-Type application/json
		respond `{"ok":true,"service":"pertitellu-corte","mode":"static-preview","backend_ready":false}` 200
	}

	@api path /api/*
	handle @api {
		respond "Pertitellu API not deployed on this preview" 503
	}

	# Compiled SPA assets must not be public during the uncertified backend phase.
	@assets path /assets/* /images/* /favicon* /robots.txt
	handle @assets {
		respond "Not published" 404
	}

	handle {
		rewrite * /en-preparation.html
		file_server
	}
}

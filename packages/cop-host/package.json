    "./constants.js": "./src/constants.js",
    "./logging/*": "./src/lib/logging/*"
  },
  "dependencies": {
    "@axiomhq/js": "^1.8.0",
    "@axiomhq/logging": "^0.1.7",
    "@axiomhq/react": "^0.1.7",
    "@inseme/brique-kudocracy": "workspace:*",
    "@inseme/ui": "workspace:*",
    "@loglayer/transport-axiom": "^2.1.16",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "glob": "^10.5.0",
    "loglayer": "^8.5.0",
    "lucide-react": "^0.563.0",
    "minimist": "^1.2.8",
    "ngrok": "5.0.0-beta.2",
    "qrcode": "^1.5.4",
    "react-router-dom": "^6.30.6",
    "serialize-error": "^11.0.3",
    "undici": "^7.29.1"
  }

    "@supabase/supabase-js": "^2.117.1",
    "dotenv": "^18.0.3",
    "glob": "^13.0.6",
    "loglayer": "^9.4.0",
    "lucide-react": "^0.577.0",
    "minimist": "^1.2.8",
    "qrcode": "^1.5.4",

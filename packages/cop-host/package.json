{
  "name": "@inseme/cop-host",
  "version": "1.0.0",
  "description": "COP Host logic for Inseme monorepo",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "type": "module",
  "bin": {
    "cop-tunnel": "./src/tunnel/runtime.js"
  },
  "exports": {
    ".": "./src/index.js",

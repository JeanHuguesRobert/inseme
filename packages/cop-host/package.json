    "./config/*": "./src/config/*",
    "./runtime/*": "./src/runtime/*",
    "./tunnel": "./src/tunnel/runtime.js",
    "./tunnel/runtime.js": "./src/tunnel/runtime.js",
    "./utils/node-proxy": "./src/utils/node-proxy.js",
    "./utils/node-proxy.js": "./src/utils/node-proxy.js",

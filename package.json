{
  "name": "inseme-monorepo",
  "private": false,
  "version": "1.0.0",
  "description": "Monorepo for Inseme and Platform Citoyenne",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:accounting": "eslint packages/cop-kernel/src/accounting packages/magistral/src/router.js packages/magistral/tests/router-packet-accounting.test.js packages/cop-kernel/test/strict-accounting-adversarial.test.js",
    "test": "pnpm --filter @inseme/cop-core test && pnpm --filter @inseme/cop-kernel test && pnpm --filter @inseme/magistral test",
    "test:accounting": "pnpm --filter @inseme/cop-kernel run test:accounting",
    "inseme:dev": "pnpm --filter @inseme/app-inseme run dev",
    "inseme:backend": "node scripts/check-tunnel.js && netlify dev --cwd apps/inseme --port 8888",
    "platform:dev": "pnpm --filter platform run dev",
    "platform:backend": "node scripts/check-tunnel.js && netlify dev --cwd apps/platform",
    "cyrnea:dev": "pnpm --filter @inseme/app-cyrnea run dev",
    "cyrnea:launch": "node scripts/cyrnea-launch.js",
    "cyrnea:dev:ui": "node scripts/cyrnea-launch.js --dev --no-compile",
    "cyrnea:dev:fast": "node scripts/cyrnea-launch.js --dev --no-compile",
    "cyrnea:dev:iter": "node scripts/cyrnea-launch.js --dev --no-compile",
    "cyrnea:doctor": "node scripts/cyrnea-doctor.js",
    "cyrnea:dev:full": "pnpm cyrnea:backend",
    "cyrnea:all": "turbo run @inseme/app-cyrnea#dev @inseme/models#sovereign:dev platform#tunnel",
    "cyrnea:tunnel": "pnpm --filter platform run tunnel",
    "cyrnea:backend": "node scripts/check-tunnel.js && netlify dev --cwd apps/cyrnea",
    "sovereign:up": "pnpm --filter @inseme/models run sovereign:up",
    "sovereign:down": "pnpm --filter @inseme/models run sovereign:down",
    "sovereign:status": "pnpm --filter @inseme/models run sovereign:status",
    "compile:briques": "node packages/cop-host/scripts/compile-briques.js",
    "inseme:build": "pnpm --filter @inseme/app-inseme run build",
    "platform:build": "pnpm --filter platform run build",
    "cyrnea:build": "pnpm --filter @inseme/app-cyrnea run build",
    "jhn:interactions:list": "node scripts/query-interaction-cases-jhn.js list",
    "jhn:interactions:get": "node scripts/query-interaction-cases-jhn.js get",
    "jhn:interactions:update": "node scripts/update-interaction-case-jhn.js",
    "jhn:interactions:refresh": "node scripts/refresh-interaction-cases-jhn.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "undici": "^8.11.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": "node scripts/prettier-staged.js"
  },
  "pnpm": {
    "overrides": {
      "http-proxy-middleware": "3.0.7",
      "multiparty": "4.3.1",
      "sharp": "0.35.4",
      "workbox-build": "7.4.1"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "dotenv": "^18.0.3",
    "node-fetch": "^3.3.2"
  }
}
